# 해설사 근무표 앱과 "같은" Supabase 프로젝트 값을 넣습니다.
# (해설사 근무표 폴더의 .env 와 같은 값 · Supabase 프로젝트 설정 > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# 아래 두 값도 해설사 근무표 앱과 반드시 같아야 같은 PIN 으로 로그인됩니다.
VITE_LOGIN_EMAIL_DOMAIN=guide.local
VITE_PIN_PEPPER=(해설사 근무표 .env 의 VITE_PIN_PEPPER 값)

# 이 일지를 쓰는 사람 - 해설사 근무표 명단의 이름과 똑같이
VITE_OWNER_NAME=김태순

# 화면에 보이는 이름 (명단의 이름과 달라도 됩니다 · 비워두면 권희)
VITE_DISPLAY_NAME=권희

# 돌봄 일지를 저장할 구글시트 웹 앱 주소 (README 1. 구글시트 연결)
# 비워두면 앱 [설정] 화면에서 넣을 수 있습니다.
VITE_SHEET_API_URL=

# 설정 화면의 "해설사 근무표 앱 열기" 주소 (생략 가능)
VITE_SCHEDULE_URL=https://haeseolsa-schedule.vercel.app/

# 말로 일지 채우기(AI)의 API 키는 여기에 넣지 않습니다. 앱 [설정 → AI 연결]에서 넣으면 구글시트 스크립트에 저장됩니다.
